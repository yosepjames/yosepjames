      "Services": {
        "$className": "Folder",
        "DataService":        { "$path": "src/ServerScriptService/Services/DataService.lua" },
        "GamepassService":    { "$path": "src/ServerScriptService/Services/GamepassService.lua" },
        "AchievementService": { "$path": "src/ServerScriptService/Services/AchievementService.lua" },
        "RebirthService":     { "$path": "src/ServerScriptService/Services/RebirthService.lua" },
